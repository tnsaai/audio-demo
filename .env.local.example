# TNSA Audio API — server-side only, never exposed to the browser.
TNSA_API_BASE_URL=https://embedding.tnsaai.com
TNSA_API_KEY=sk-...

# Optional: absolute path to the local ARen dataset checkout.
# Without it the sample bank is empty and upload/record still work.
AREN_DIR=C:\Users\NACHIKETH\Desktop\TNSA-Eval\aren

# Optional: drop-in folder for your own clips (e.g. Indic audio).
# Any .wav/.mp3/.m4a/.ogg/.flac in here shows up in the sample bank.
CUSTOM_AUDIO_DIR=

# Sign-in. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEMO_USER=demo
DEMO_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
