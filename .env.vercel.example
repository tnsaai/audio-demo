# Production environment for Vercel.
#
# Template. Copy to .env.vercel and fill in, then paste into
# Vercel -> Project -> Settings -> Environment Variables.
#
# Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- TNSA Audio API (server-side only, never exposed to the browser) ---
TNSA_API_BASE_URL=https://embedding.tnsaai.com
TNSA_API_KEY=sk-...

# --- Dataset: read from Hugging Face, no local filesystem needed ---
HF_DATASET_REPO=TNSA/Aren
HF_DATASET_REVISION=main
# Only needed if the dataset is made private or gated. Public today.
HF_TOKEN=

# Leave AREN_DIR and CUSTOM_AUDIO_DIR unset in production: serverless has no
# persistent local filesystem, and setting them would break the sample bank.

# --- Sign-in ---
DEMO_USER=demo
DEMO_PASSWORD=choose-a-strong-password
SESSION_SECRET=generate-with-the-command-below
# Vercel serves HTTPS, so the session cookie must be Secure.
COOKIE_SECURE=true
